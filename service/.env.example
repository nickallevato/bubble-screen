# Paperclip API base URL, including /api
PAPERCLIP_API_BASE=https://paperclip.example.com/api
# An API key for the agent being shown: POST /api/agents/{AGENT_ID}/keys.
# Paperclip keys have no read-only scope; bubble-screen only ever issues GETs.
PAPERCLIP_TOKEN=
# The agent to show, and its company
AGENT_ID=
COMPANY_ID=
# Shared secret the display sends as "Authorization: Bearer ..." (e.g. `openssl rand -hex 24`)
DEVICE_PSK=
